# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Operational output ---
